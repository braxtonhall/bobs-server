model Token {
  id             Int      @id @default(autoincrement())
  email          Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  type           String
  emailId        String
  temporaryToken String?  @unique
  valid          Boolean  @default(true)
  expiration     DateTime
  familyId       String?
  // SSO codes only: the callback URL the code was issued for
  redirect       String?

  @@index([familyId])
}
