model CrdtDocument {
  id            String             @id @default(cuid())
  owner         Email              @relation("CrdtDocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String
  type          String             @default("private")
  snapshot      Bytes?
  operations    CrdtOperation[]
  collaborators CrdtCollaborator[]
  createdAt     DateTime           @default(now())
}

model CrdtOperation {
  id         Int          @id @default(autoincrement())
  document   CrdtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  update     Bytes
}

model CrdtCollaborator {
  id         Int          @id @default(autoincrement())
  document   CrdtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  email      Email        @relation("CrdtCollaboratorEmail", fields: [emailId], references: [id], onDelete: Cascade)
  emailId    String

  @@unique([documentId, emailId])
}
