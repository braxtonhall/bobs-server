######
## Meta
NODE_ENV=production

############
## Database
DATABASE_URL=file://home/runner/work/bobs-server/db/db.sqlite
HOST_DB_DIR=/home/runner/work/bobs-server/db

######
## Auth
JWT_SECRET=someVeryLongString...
LOGIN_TOKEN_EXPIRATION_MIN=10
ACCESS_TOKEN_EXPIRATION_MIN=15
REFRESH_TOKEN_EXPIRATION_DAYS=60
VERIFY_TOKEN_EXPIRATION_DAYS=90

######
## SSO
# Comma-separated callback URLs that other services may ask /sso to redirect to
SSO_REDIRECTS=https://sink.bobs-server.net/operator/callback
# Shared with those services; required to call /api/sso/exchange
SSO_EXCHANGE_SECRET=someVeryLongString...
SSO_CODE_EXPIRATION_SEC=60

######
## Email
HOST=my.website.com
EMAIL_FROM=donotreply@mail.website.net
BREVO_API_KEY=someVeryLongString...
EMAIL_DISABLED=true

######
## Box settings
DEFAULT_PAGE_SIZE=20
MAXIMUM_PAGE_SIZE=100
# How long after a post is created is a poster allowed to delete it?
DELETION_TIME_MIN=10
# How many comments should be killed before the poster is shadow-banned?
KARMA_KILL_THRESHOLD=5
# How often to scan the database for new notifications to go out
SUBSCRIPTION_DIGEST_INTERVAL_HOURS=4
# How long between a notification goes out for the same user to get another
SUBSCRIPTION_DIGEST_DELAY_HOURS=12

######
## SSL/Server settings
# Leave both unset to serve plain HTTP on HTTP_PORT behind a reverse proxy
SSL_CERT_PATH=/etc/ssl/fullchain.pem
SSL_KEY_PATH=/etc/ssl/privkey.pem
# Express "trust proxy" setting; "uniquelocal" trusts a proxy on a Docker network
TRUST_PROXY=
HTTP_PORT=80
HTTPS_PORT=443
SESSION_SECRET=someVeryLongString...

######
## ReCAPTCHA
RECAPTCHA_SITE_KEY=someVeryLongString...
RECAPTCHA_SECRET_KEY=someVeryLongString...
